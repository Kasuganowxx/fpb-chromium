diff --git a/third_party/blink/renderer/modules/webgl/webgl_fingerprint.cc b/third_party/blink/renderer/modules/webgl/webgl_fingerprint.cc
new file mode 100644
index 0000000..2570c04
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/webgl_fingerprint.cc
@@ -0,0 +1,204 @@
+// Copyright 2024 The ungoogled-chromium Authors
+
+#include "third_party/blink/renderer/modules/webgl/webgl_fingerprint.h"
+
+#include <array>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "components/ungoogled/webgl_config_data.h"
+#include "third_party/blink/renderer/bindings/modules/v8/webgl_any.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+namespace {
+
+using ungoogled::fingerprint::kMacOSWebGLConfigs;
+using ungoogled::fingerprint::kWindowsWebGLConfigs;
+using ungoogled::fingerprint::WebGLConfig;
+using ungoogled::fingerprint::WebGLParamSet;
+
+// Returns the active per-device config, or nullptr when WebGL spoofing is off
+// for this process (no --fingerprint, disabled via --disable-spoofing=gpu, or a
+// platform with no config data such as linux).
+const WebGLConfig* GetActiveWebGLConfig() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint)) {
+    return nullptr;
+  }
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("gpu") != std::string::npos) {
+    return nullptr;
+  }
+
+  std::string platform = "windows";
+  if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+    platform = base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+  }
+
+  base::span<const WebGLConfig> configs;
+  if (platform == "windows") {
+    configs = base::span(kWindowsWebGLConfigs);
+  } else if (platform == "macos") {
+    configs = base::span(kMacOSWebGLConfigs);
+  } else {
+    // linux / unknown platform: no config data, do not spoof.
+    return nullptr;
+  }
+
+  uint64_t seed = 0;
+  base::StringToUint64(
+      command_line->GetSwitchValueASCII(switches::kFingerprint), &seed);
+  return &configs[static_cast<size_t>(seed % configs.size())];
+}
+
+const WebGLParamSet& ActiveParamSet(const WebGLConfig& config, bool is_webgl2) {
+  return is_webgl2 ? config.gl2 : config.gl1;
+}
+
+// WEBGL_debug_renderer_info enums (webgl_debug_renderer_info.h). These are
+// extension-gated upstream and handled at their case sites, not at the top.
+constexpr unsigned kUnmaskedVendorWebgl = 0x9245;
+constexpr unsigned kUnmaskedRendererWebgl = 0x9246;
+
+// Full lookup over the active config's parameter set (includes UNMASKED_*).
+bool LookupWebGLParameter(ScriptState* script_state,
+                          unsigned pname,
+                          bool is_webgl2,
+                          ScriptValue* out) {
+  const WebGLConfig* config = GetActiveWebGLConfig();
+  if (!config) {
+    return false;
+  }
+  const WebGLParamSet& params = ActiveParamSet(*config, is_webgl2);
+
+  for (const auto& e : params.i32) {
+    if (e.pname == pname) {
+      *out = WebGLAny(script_state, static_cast<int>(e.value));
+      return true;
+    }
+  }
+  for (const auto& e : params.u32) {
+    if (e.pname == pname) {
+      *out = WebGLAny(script_state, static_cast<unsigned>(e.value));
+      return true;
+    }
+  }
+  for (const auto& e : params.i64) {
+    if (e.pname == pname) {
+      *out = WebGLAny(script_state, static_cast<int64_t>(e.value));
+      return true;
+    }
+  }
+  for (const auto& e : params.f32) {
+    if (e.pname == pname) {
+      *out = WebGLAny(script_state, e.value);
+      return true;
+    }
+  }
+  for (const auto& e : params.farray) {
+    if (e.pname == pname) {
+      std::array<float, 2> v = {static_cast<float>(e.v0),
+                                static_cast<float>(e.v1)};
+      *out = WebGLAny(script_state,
+                      DOMFloat32Array::Create(base::span<const float>(v)));
+      return true;
+    }
+  }
+  for (const auto& e : params.iarray) {
+    if (e.pname == pname) {
+      std::array<int32_t, 2> v = {e.v0, e.v1};
+      *out = WebGLAny(script_state,
+                      DOMInt32Array::Create(base::span<const int32_t>(v)));
+      return true;
+    }
+  }
+  for (const auto& e : params.str) {
+    if (e.pname == pname) {
+      *out = WebGLAny(script_state, String(e.value));
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool IsWebGLFingerprintEnabled() {
+  return GetActiveWebGLConfig() != nullptr;
+}
+
+bool TryGetWebGLParameter(ScriptState* script_state,
+                          unsigned pname,
+                          bool is_webgl2,
+                          ScriptValue* out) {
+  // UNMASKED_* are extension-gated; let their case sites handle them via
+  // TryGetWebGLUnmaskedParameter() so spoofing only happens once the
+  // WEBGL_debug_renderer_info extension is enabled.
+  if (pname == kUnmaskedVendorWebgl || pname == kUnmaskedRendererWebgl) {
+    return false;
+  }
+  return LookupWebGLParameter(script_state, pname, is_webgl2, out);
+}
+
+bool TryGetWebGLUnmaskedParameter(ScriptState* script_state,
+                                  unsigned pname,
+                                  bool is_webgl2,
+                                  ScriptValue* out) {
+  return LookupWebGLParameter(script_state, pname, is_webgl2, out);
+}
+
+void ApplyWebGLUnmaskedParameterTimingDelay(unsigned pname) {
+  if (pname != kUnmaskedVendorWebgl && pname != kUnmaskedRendererWebgl) {
+    return;
+  }
+  if (!IsWebGLFingerprintEnabled()) {
+    return;
+  }
+
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + base::Microseconds(16);
+  while (base::TimeTicks::Now() < deadline) {
+  }
+}
+
+bool TryGetWebGLShaderPrecision(unsigned shader_type,
+                                unsigned precision_type,
+                                bool is_webgl2,
+                                int range[2],
+                                int* precision) {
+  const WebGLConfig* config = GetActiveWebGLConfig();
+  if (!config) {
+    return false;
+  }
+  const WebGLParamSet& params = ActiveParamSet(*config, is_webgl2);
+  for (const auto& e : params.prec) {
+    if (e.shader_type == shader_type && e.precision_type == precision_type) {
+      range[0] = e.range_min;
+      range[1] = e.range_max;
+      *precision = e.precision;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool TryGetWebGLAntialias(bool is_webgl2, bool* antialias) {
+  const WebGLConfig* config = GetActiveWebGLConfig();
+  if (!config) {
+    return false;
+  }
+  *antialias = ActiveParamSet(*config, is_webgl2).antialias;
+  return true;
+}
+
+}  // namespace blink
